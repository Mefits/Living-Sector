extends SceneTree
const Docking = preload("res://scripts/sim/ships/docking_registry.gd")

func _initialize() -> void:
	var d = Docking.new()
	assert(d.register_facility("yard", "earth", 1, "shipyard"))
	assert(d.register_facility("trade", "earth", 2, "trade"))
	assert(d.register_ship("s2", "earth"))
	assert(d.register_ship("s1", "earth"))
	var first: Dictionary = d.request_dock("s1", "op-1", "shipyard")
	assert(first.get("ok") and first.get("facility_id") == "yard")
	assert(d.request_dock("s1", "op-1") == first)
	assert(d.request_dock("s2", "op-2", "shipyard").get("reason") == "no_available_dock")
	assert(not d.begin_transit("s1"))
	assert(d.undock("s1", "op-3").get("ok"))
	assert(d.begin_transit("s1"))
	assert(d.request_dock("s1", "op-4").get("reason") == "in_transit")
	assert(d.arrive("s1", "earth"))
	assert(d.request_dock("s1", "op-5", "shipyard").get("ok"))
	var snap: Dictionary = d.snapshot()
	var restored = Docking.new()
	assert(restored.restore(snap))
	assert(restored.snapshot() == snap)
	assert(restored.request_dock("s1", "op-5").get("ok"))
	var corrupt: Dictionary = snap.duplicate(true)
	corrupt["occupants"]["yard"].append("ghost")
	assert(not restored.restore(corrupt))
	assert(restored.snapshot() == snap)
	assert(restored.undock("s1", "op-6").get("ok"))
	assert(restored.request_dock("s2", "op-7", "shipyard").get("ok"))
	print("N21 docking smoke PASS")
	quit(0)
