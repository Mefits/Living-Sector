extends SceneTree
## Run with: godot --headless --path godot --script res://tests/p2_perf_d_event_queue_redundant_maps_oracle.gd
const Queue = preload("res://scripts/sim/event_queue.gd")

func _initialize() -> void:
    var q = Queue.new()
    assert(q.schedule("late", 8, 1, "z", "unknown", {"nested": {"v": 3}}))
    assert(q.schedule("first", 5, 1, "b", "unknown"))
    assert(q.schedule("second", 5, 1, "a", "unknown"))
    assert(not q.schedule("first", 5, 1, "b", "unknown"))
    assert(q.cancel("late"))
    assert(not q.cancel("late"))
    assert(q.pending_count() == 2)
    var original: Dictionary = q.snapshot()
    assert(original["pending"].size() == 2)
    assert(original["pending"][0]["id"] == "second")
    assert(original["pending"][1]["id"] == "first")
    var restored = Queue.new()
    assert(restored.restore(original, 4, 3))
    assert(restored.pending_count() == 2)
    assert(restored.take_due(5, 0).is_empty())
    var due: Array[Dictionary] = restored.take_due(5, 1)
    assert(due.size() == 2)
    assert(due[0]["id"] == "second")
    assert(due[1]["id"] == "first")
    assert(restored.take_due(5, 1).is_empty())
    assert(restored.pending_count() == 0)
    assert(q.pending_count() == 2)
    var bad: Dictionary = original.duplicate(true)
    bad["pending"][1]["sequence"] = bad["pending"][0]["sequence"]
    assert(not restored.restore(bad, 4, 3))
    assert(restored.pending_count() == 0)
    assert(restored.schedule("after", 9, 0, "x", "unknown"))
    assert(restored.cancel("after"))
    assert(restored.pending_count() == 0)
    print("PASS p2_perf_d_event_queue_redundant_maps_oracle")
    quit(0)
