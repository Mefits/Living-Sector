extends SceneTree
const Queue = preload("res://scripts/sim/event_queue.gd")

func _initialize() -> void:
    var q = Queue.new()
    assert(q.schedule("z", 8, 1, "b", "unknown", {"nested": [1]}))
    assert(q.schedule("a", 8, 1, "a", "unknown"))
    assert(q.schedule("x", 8, 1, "a", "unknown"))
    assert(q.schedule("later", 9, 1, "a", "unknown"))
    assert(q.schedule("other_phase", 8, 2, "a", "unknown"))
    assert(q.cancel("x"))
    assert(not q.cancel("x"))
    assert(not q.cancel("missing"))
    assert(q.schedule("x2", 8, 1, "a", "unknown"))
    var saved: Dictionary = q.snapshot()
    var restored = Queue.new()
    assert(restored.restore(saved, 7, 3))
    var first: Array[Dictionary] = q.take_due(8, 1)
    var second: Array[Dictionary] = restored.take_due(8, 1)
    assert(first == second)
    assert(first.size() == 3)
    assert(first[0]["id"] == "a")
    assert(first[1]["id"] == "x2")
    assert(first[2]["id"] == "z")
    assert(q.take_due(8, 1).is_empty())
    assert(q.pending_count() == 2)
    assert(q.take_due(8, 2) == restored.take_due(8, 2))
    assert(q.take_due(9, 1) == restored.take_due(9, 1))
    assert(q.pending_count() == 0)
    var bad: Dictionary = saved.duplicate(true)
    bad["pending"][0]["due_tick"] = 7
    var untouched: Dictionary = restored.snapshot()
    assert(not restored.restore(bad, 7, 3))
    assert(restored.snapshot() == untouched)
    quit(0)
