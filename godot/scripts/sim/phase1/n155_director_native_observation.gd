extends RefCounted
## Frozen strategy/director.rs::Profile::from_personality, record,
## observe(read-only reconstruction), option_score. Research select+work,
## charters and crisis cadence belong EXCLUSIVELY to N143/N133/N109.
## The director does not produce goods, award money or modify World.
const ARCHETYPES := ["economist","pacifist","aggressor","expansionist","technocrat","isolationist"]

static func profile_from_personality(personality: Dictionary) -> Dictionary:
	var prefers: Dictionary = personality.get("prefer_goals", {})
	var mix: Dictionary = {}
	for name in ARCHETYPES:
		var weight: float = float(prefers.get("leader_" + name, 0.0))
		if is_finite(weight) and weight > 0.0:
			mix[name] = weight
	if mix.is_empty():
		mix["economist"] = 1.0
		mix["aggressor" if float(personality.get("aggression", 0.0)) > 0.6 else "pacifist"] = 1.0
	var total: float = 0.0
	for weight in mix.values():
		total += float(weight)
	for name in mix.keys():
		mix[name] = float(mix[name]) / total
	var econ: float = float(mix.get("economist",0.0))
	var techno: float = float(mix.get("technocrat",0.0))
	var peaceful: float = float(mix.get("pacifist",0.0))
	var aggress: float = float(mix.get("aggressor",0.0))
	var expand: float = float(mix.get("expansionist",0.0))
	var isolate: float = float(mix.get("isolationist",0.0))
	return {"archetypes":mix,
		"industry":1.0 + 1.4*econ + 0.3*techno,
		"science":0.65 + 2.0*techno + 0.3*peaceful,
		"expansion":maxf(0.2,0.7 + 1.6*expand + 0.7*aggress - 0.5*isolate),
		"caution":0.6 + 0.9*peaceful + isolate,
		"aggression":aggress}

static func option_score(commander: Dictionary, goal: Dictionary, alternative: Dictionary) -> float:
	## Rust director.rs::option_score: native option must already be
	## physically "ready"; positive benefit or genuine Food/Water crisis.
	var item: String = str(goal.get("commodity",""))
	var survival: bool = item in ["food","water"]
	var action: String = str(alternative.get("action",""))
	var ready: bool = str(alternative.get("status","")) == "ready"
	var place: String = str(goal.get("destination",""))
	var goal_name: String = str(goal.get("goal_id",""))
	var profile: Dictionary = commander.get("profile",{})
	var site_present: bool = alternative.get("site_id",null) != null
	if action == "build" and ready and (
		goal_name in ["develop_colony","player_industry"] or
		(place.ends_with("-colony") and site_present)):
		return 35.0 * float(profile.get("industry",1.0)) + (8.0 if site_present else 0.0)
	if not ready or float(alternative.get("covered_units",0.0)) <= 0.0:
		return -1.0
	var net: float = float(alternative.get("estimated_net_value",0.0))
	if not is_finite(net):
		net = 0.0
	var crisis: bool = bool(commander.get("crisis",false))
	if net <= 0.0 and not (survival and crisis):
		return -1.0
	var weight: float = float(profile.get("industry",1.0)) if action == "build" else 1.0
	var benefit: float = log(1.0+maxf(0.0,net))*weight
	return (benefit + (1000.0 if survival and crisis else 0.0)
		+ float(mini(1000,maxi(0,int(goal.get("shortage_ticks",0)))))*0.01
		+ (5.0 if site_present else 0.0))

static func append_record(commander: Dictionary, tick: int, action: String,
		reason: String, outcome: String) -> Dictionary:
	var updated: Dictionary = commander.duplicate(true)
	var history: Array = updated.get("history",[])
	history.append({"tick":tick,"action":action,"reason":reason,"outcome":outcome})
	if history.size() > 100:
		history.pop_front()
	updated["history"] = history
	return updated

static func observe_commander(previous: Dictionary, faction: Dictionary,
		snapshot: Dictionary, tick: int, mult: int) -> Dictionary:
	## Typed immutable snapshot from existing N150 facility/market/population,
	## N152 ContractBoard Paid and N143 Director commands. All inputs are
	## real world readbacks, not generated by director.
	var faction_id: String = str(faction.get("id",""))
	if faction_id.is_empty():
		return {}
	var commander: Dictionary = previous.duplicate(true)
	if commander.is_empty():
		commander = {"intent":"stabilize","since":tick,"reason":"",
			"candidates":[],"technologies":[],"research":null,"progress":0,
			"research_required":0,"last_research_tick":null,"history":[],
			"crisis":false,"stations":0,"colonies":0,"completed_contracts":0,
			"blocked_cycles":0,"last_shift":null,
			"next_crisis_tick":tick + 1800 * maxi(1,mult),
			"strategic":{}}
	commander["profile"] = profile_from_personality(faction.get("personality",{}))
	var markets_by_location: Dictionary = snapshot.get("markets_by_location",{})
	var crisis: bool = false
	for household in snapshot.get("population",[]):
		var count: int = int(household.get("population_count",0))
		if str(household.get("faction_id","")) != faction_id or count <= 0:
			continue
		var location: String = str(household.get("facility_location",""))
		if not markets_by_location.has(location):
			continue
		var market: Dictionary = markets_by_location[location]
		var supply: Dictionary = market.get("supply",{})
		for good in ["food","water"]:
			if float(supply.get(good,0.0)) < maxf(float(count)*0.15,8.0):
				crisis = true
	commander["crisis"] = crisis
	var stations: int = 0
	var colonies: int = 0
	for facility in snapshot.get("facilities",[]):
		if str(facility.get("faction_id","")) != faction_id or str(facility.get("facility_type","")) != "station":
			continue
		stations += 1
		if str(facility.get("location_name","")).ends_with("-colony"):
			colonies += 1
	var paid: int = 0
	for contract in snapshot.get("contracts",[]):
		if str(contract.get("requestor_id","")) == faction_id and str(contract.get("status","")) == "Paid":
			paid += 1
	if colonies > int(previous.get("colonies",0)):
		commander = append_record(commander,tick,"colony_completed",
			"Доставка материалов, переселенцев и оплаченный труд завершены","completed")
	if paid > int(previous.get("completed_contracts",0)):
		commander = append_record(commander,tick,"contract_completed",
			"Исполнитель завершил оплаченный контракт","completed")
	commander["stations"] = stations
	commander["colonies"] = colonies
	commander["completed_contracts"] = paid
	# Native delegated research target/priority remains an N143-only
	# post-observation step; no second research progress/payment here.
	return commander
