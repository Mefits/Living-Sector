# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor / IDE
*.swp
*~
.vscode/settings.json
.vscode/*.code-workspace
.idea/

# Claude Code harness — local settings are machine-specific.
# `settings.json` captures per-session permission grants (bare PIDs,
# absolute user paths, etc.), so it's as local as settings.local.json.
# `skills/` dirs stay trackable — those are shared agent definitions.
**/.claude/settings.json
**/.claude/settings.local.json
**/.claude/projects/

# Any top-level scratch files / one-off archives
*.tar.gz
/backup/

# Rust (simulator-rust/ — remove these lines if you want to track that project)
simulator-rust/target/
