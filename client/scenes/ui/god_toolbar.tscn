[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/god_toolbar.gd" id="1"]

[node name="GodToolbar" type="PanelContainer"]
script = ExtResource("1")

[node name="HBox" type="HBoxContainer" parent="."]
