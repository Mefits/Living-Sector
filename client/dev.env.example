# Local dev toggles for ServerManager. Copy to `dev.env` (which is
# gitignored) to enable for your machine.
#
# When set, the client will NOT spawn the bundled BEAM — it will wait
# for an external simulator running on localhost:4000 (the usual
# `mix phx.server` workflow). Leave this file absent / commented out
# in exported builds so they always spawn the bundled server.

SPACESIM_USE_EXISTING_SERVER=1
