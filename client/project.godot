; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Space Simulator Client"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ServerManager="*res://scripts/autoload/server_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
ProceduralAudio="*res://scripts/autoload/procedural_audio.gd"
MusicPlayer="*res://scripts/autoload/music_player.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://logs/client.log"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/custom="res://assets/themes/holographic.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
