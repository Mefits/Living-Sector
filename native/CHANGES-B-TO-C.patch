+    fn id(&self)->&'static str {"hybrid_utility_htn_goap_beam"}
+    fn plan(&self,snapshot:&PlanningSnapshot,goal:&GoalSpec,
+        actions:&[ActionSpec],budget:SearchBudget)->PlanResult {
+        self.decide(snapshot,goal,actions,budget).result
+    }
+}
